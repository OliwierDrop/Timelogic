POSTGRES_DB=timelogic
POSTGRES_USER=timelogic
POSTGRES_PASSWORD=change-this-local-password
PUBLIC_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
UPLOAD_DIR=/data/uploads
# Tajny klucz (szyfrowanie hasła SMTP) — instalator generuje automatycznie
# APP_SECRET=change-me-long-random-string
# Overlay compose po instalacji serwerowej (install.sh ustawia to sam)
# COMPOSE_FILE=compose.yaml:scripts/compose.proxy.yml
# Za reverse proxy (produkcja): IP/CIDR peerów, z których ufamy X-Forwarded-For
# TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

# Opcjonalny seed SMTP (jednorazowo → baza); później edycja w /organizacja
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=noreply@example.com
# SMTP_STARTTLS=true
# SMTP_USER=
# SMTP_PASSWORD=

# Pierwszy admin (uruchom w kontenerze API: python -m app.bootstrap) — konto + karta w Zespole
# BOOTSTRAP_EMAIL=admin@example.com
# BOOTSTRAP_PASSWORD=change-me-min-12-chars
# BOOTSTRAP_ORGANIZATION=Moja organizacja
# BOOTSTRAP_TIMEZONE=Europe/Warsaw
# BOOTSTRAP_FIRST_NAME=Administrator
# BOOTSTRAP_LAST_NAME=System
